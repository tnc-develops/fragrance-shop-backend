generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(191)
  phone        String?    @db.VarChar(30)
  passwordHash String     @db.VarChar(255)
  /// Tokens issued before this moment are rejected, so changing the password signs out other devices.
  passwordChangedAt DateTime?
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  reviews      Review[]
  cartItems    CartItem[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  description String?   @db.Text
  image       String?   @db.VarChar(500)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

/// Shared details of a fragrance. Price, stock and size live on its variants (one per bottle size);
/// `price`, `salePrice`, `stock` and `sizeMl` here are a summary kept in sync for listing, sorting and filtering.
model Product {
  id               Int              @id @default(autoincrement())
  name             String           @db.VarChar(160)
  slug             String           @unique @db.VarChar(191)
  brand            String?          @db.VarChar(120)
  shortDescription String?          @db.VarChar(300)
  description      String?          @db.Text
  /// Cheapest active variant's regular price.
  price            Decimal          @db.Decimal(10, 2)
  /// Cheapest active variant's sale price.
  salePrice        Decimal?         @db.Decimal(10, 2)
  /// Total stock across active variants.
  stock            Int              @default(0)
  /// Default variant's size.
  sizeMl           Int?
  concentration    String?          @db.VarChar(60)
  gender           Gender         @default(UNISEX)
  topNotes         String?        @db.VarChar(300)
  heartNotes       String?        @db.VarChar(300)
  baseNotes        String?        @db.VarChar(300)
  featured         Boolean        @default(false)
  isActive         Boolean        @default(true)
  /// Optional Google title and description; generated from the product details when empty.
  seoTitle         String?        @db.VarChar(160)
  seoDescription   String?        @db.VarChar(320)
  ratingAvg        Decimal        @default(0) @db.Decimal(3, 2)
  ratingCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  categories       Category[]
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  cartItems        CartItem[]

  @@index([isActive, featured])
  @@index([createdAt])
}

/// A purchasable size of a product. Empty text fields and an empty image list fall back to the product's.
model ProductVariant {
  id               Int            @id @default(autoincrement())
  productId        Int
  sizeMl           Int?
  /// Optional display name such as "Travel spray"; defaults to "<sizeMl> ml".
  label            String?        @db.VarChar(60)
  price            Decimal        @db.Decimal(10, 2)
  salePrice        Decimal?       @db.Decimal(10, 2)
  stock            Int            @default(0)
  sku              String?        @unique @db.VarChar(64)
  shortDescription String?        @db.VarChar(300)
  description      String?        @db.Text
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  orderItems       OrderItem[]
  cartItems        CartItem[]

  @@index([productId, sortOrder])
  @@index([isActive, stock])
}

/// Images with no `variantId` form the product's shared gallery; others belong to one size.
model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int
  variantId Int?
  url       String          @db.VarChar(500)
  alt       String?         @db.VarChar(200)
  sortOrder Int             @default(0)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  userId    Int
  productId Int
  variantId Int
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([productId])
}

model Order {
  id            Int           @id @default(autoincrement())
  orderNumber   String        @unique @db.VarChar(32)
  userId        Int?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal      Decimal       @db.Decimal(10, 2)
  shippingFee   Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @db.VarChar(8)
  customerName  String        @db.VarChar(120)
  email         String        @db.VarChar(191)
  phone         String        @db.VarChar(30)
  addressLine1  String        @db.VarChar(255)
  addressLine2  String?       @db.VarChar(255)
  city          String        @db.VarChar(120)
  state         String?       @db.VarChar(120)
  postalCode    String?       @db.VarChar(20)
  country       String        @db.VarChar(80)
  notes         String?       @db.Text
  /// Bank transfer slip, stored outside the public uploads folder (path relative to the private upload dir).
  paymentSlip           String?   @db.VarChar(300)
  paymentSlipUploadedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  events        OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           Int             @id @default(autoincrement())
  orderId      Int
  productId    Int?
  variantId    Int?
  name         String          @db.VarChar(160)
  /// Size bought, e.g. "50 ml" (kept even if the variant is later deleted).
  variantLabel String?         @db.VarChar(60)
  image        String?         @db.VarChar(500)
  price        Decimal         @db.Decimal(10, 2)
  quantity     Int
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?     @db.VarChar(500)
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  title     String?  @db.VarChar(160)
  comment   String?  @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([approved])
}

model HeroSlide {
  id           Int      @id @default(autoincrement())
  imageDesktop String   @db.VarChar(500)
  imageMobile  String?  @db.VarChar(500)
  eyebrow      String?  @db.VarChar(120)
  heading      String?  @db.VarChar(200)
  subheading   String?  @db.VarChar(400)
  ctaLabel     String?  @db.VarChar(60)
  ctaLink      String?  @db.VarChar(300)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Poster {
  id           Int      @id @default(autoincrement())
  imageDesktop String   @db.VarChar(500)
  imageMobile  String?  @db.VarChar(500)
  title        String?  @db.VarChar(200)
  link         String?  @db.VarChar(300)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Singleton row (id = 1) holding storefront customization.
model ShopSetting {
  id                    Int      @id @default(1)
  shopName              String   @db.VarChar(120)
  tagline               String?  @db.VarChar(200)
  /// Logo for light backgrounds (header, admin login).
  logoLightUrl          String?  @db.VarChar(500)
  /// Logo for dark backgrounds (footer, admin sidebar).
  logoDarkUrl           String?  @db.VarChar(500)
  announcement          String?  @db.VarChar(300)
  currency              String   @default("LKR") @db.VarChar(8)
  currencySymbol        String   @default("LKR") @db.VarChar(8)
  shippingFee           Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal? @db.Decimal(10, 2)
  heroIntervalMs        Int      @default(5000)
  contactEmail          String?  @db.VarChar(191)
  contactPhone          String?  @db.VarChar(30)
  whatsappNumber        String?  @db.VarChar(30)
  openingHours          String?  @db.VarChar(200)
  address               String?  @db.VarChar(300)
  instagramUrl          String?  @db.VarChar(300)
  facebookUrl           String?  @db.VarChar(300)
  metaDescription       String?  @db.VarChar(300)
  /// Home page title in Google results.
  seoTitle              String?  @db.VarChar(160)
  /// Comma-separated search phrases customers use, e.g. "perfume Sri Lanka, buy perfume online".
  seoKeywords           String?  @db.Text
  /// Content of the google-site-verification meta tag from Google Search Console.
  googleVerification    String?  @db.VarChar(120)
  /// Visible keyword-rich introduction near the bottom of the home page.
  seoIntroHeading       String?  @db.VarChar(160)
  seoIntroText          String?  @db.Text
  colors                Json
  updatedAt             DateTime @updatedAt
}

/// How customers can pay: one row per method, edited and switched on or off in the admin.
model PaymentOption {
  id                Int           @id @default(autoincrement())
  method            PaymentMethod @unique
  name              String        @db.VarChar(80)
  /// Shown under the name at checkout.
  description       String?       @db.VarChar(300)
  /// Shown with the bank details at checkout and on the order page.
  instructions      String?       @db.Text
  isActive          Boolean       @default(false)
  sortOrder         Int           @default(0)
  /// Bank transfer only: [{ bankName, accountName, accountNumber, branch }].
  bankAccounts      Json?
  /// Bank transfer only: customers can upload a photo or PDF of their payment slip.
  allowSlipUpload   Boolean       @default(true)
  /// Bank transfer only: offer a button to send the slip to the shop's WhatsApp number.
  allowWhatsappSlip Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/// Content of the storefront's About us page (single row, id 1).
model AboutPage {
  id         Int      @id @default(1)
  eyebrow    String?  @db.VarChar(80)
  heading    String   @db.VarChar(160)
  intro      String?  @db.Text
  heroImage  String?  @db.VarChar(500)
  /// Story blocks: [{ title, body, image }], shown with the image alternating left and right.
  sections   Json
  /// Short brand promises: [{ title, text }].
  values     Json
  ctaHeading String?  @db.VarChar(160)
  ctaLabel   String?  @db.VarChar(60)
  ctaLink    String?  @db.VarChar(300)
  updatedAt  DateTime @updatedAt
}
