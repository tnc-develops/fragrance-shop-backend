NODE_ENV=development
PORT=4000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/fragrance_shop"

# Production refuses to start unless this is a random string of 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Admin sign-ins expire sooner than customer sign-ins.
ADMIN_JWT_EXPIRES_IN="12h"

UPLOAD_DIR=uploads
# Bank transfer slips go here. Keep it outside any publicly served folder.
PRIVATE_UPLOAD_DIR=private-uploads
# Largest product/media image, in MB.
MAX_UPLOAD_MB=8
# Largest bank transfer slip, in MB. If a reverse proxy (nginx) sits in front, set its body limit at least this high.
SLIP_MAX_MB=10

# Public URL of this API, used to build absolute image URLs.
PUBLIC_URL=http://localhost:4000

# Comma-separated list of allowed browser origins (storefront + admin subdomain).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seeded admin account
ADMIN_EMAIL=admin@fragrancebyshoon.com
ADMIN_PASSWORD=Admin@12345
